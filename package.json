{
  "name": "vet402-paypal",
  "version": "0.0.1",
  "private": true,
  "description": "Fund an agent's data job with PayPal: buy from sellers with a real track record, check every delivery against the promise, capture only what passed.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx src/server/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:static": "vite build --config web/vite.static.config.ts",
    "screens": "tsx scripts/screenshots.ts",
    "eval": "node --no-deprecation --import tsx eval/run.ts",
    "mcp": "node --no-deprecation --import tsx src/mcp/main.ts",
    "sellers": "node --no-deprecation --import tsx scripts/seller-totals.ts",
    "fetch:export": "node --no-deprecation --import tsx scripts/fetch-export.ts",
    "test:sandbox": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.ts",
    "sandbox:run": "node --no-deprecation --env-file=.env --import tsx scripts/sandbox-run.ts",
    "demo:sandbox": "node --no-deprecation --env-file=.env --import tsx scripts/demo-sandbox.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.8",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "4.6.16",
    "tsx": "4.19.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/figtree": "5.2.8",
    "@fontsource/newsreader": "5.2.8",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "ag-grid-community": "32.3.3",
    "ag-grid-react": "32.3.3",
    "playwright": "1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "6.0.11",
    "vitest": "2.1.9"
  }
}
